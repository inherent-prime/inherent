meta {
  name: List Dead-letter Jobs
  type: http
  seq: 1
}

get {
  url: {{ingest_base}}/dead-letter?workspace_id={{workspace_id}}&status=pending&limit=50
  body: none
  auth: inherit
}

params:query {
  workspace_id: {{workspace_id}}
  status: pending
  limit: 50
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
}

docs {
  List dead-letter jobs. `workspace_id` is required (#177 -- it used to be an optional filter,
  which returned every workspace's dead-letter rows). Optional: `status` (default `pending`),
  `limit` (1–200, default 50).
}
